# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable "sb_publishable_..." ou a anon legada)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: usada SOMENTE no servidor. Nunca expor no front nem commitar.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do site (usada nos links de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marca e contato do celebrante (aparecem na página inicial)
# Como o celebrante é chamado nas frases. Ex.: "o Rubinho"
NEXT_PUBLIC_CELEBRANTE_NOME=o celebrante
# WhatsApp só com dígitos e DDI. Ex.: 5511999999999
NEXT_PUBLIC_CONTATO_WHATSAPP=
NEXT_PUBLIC_CONTATO_EMAIL=
